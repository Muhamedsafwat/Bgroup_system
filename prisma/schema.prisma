// ============================================================================
// CRM MODULE — User Profile
// ============================================================================

model CrmUserProfile {
  id               String       @id @default(cuid())
  userId           String       @unique
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  fullName         String       @default("")
  fullNameAr       String?
  phone            String?
  avatarUrl        String?
  role             CrmRole      @default(REP)
  entityId         String?
  entity           CrmEntity?   @relation(fields: [entityId], references: [id])
  monthlyTargetEGP Decimal?     @db.Decimal(12, 2)
  active           Boolean      @default(true)

  /// Legacy single-FK "primary manager" — the rep's first or main reporting
  /// line. Visibility queries now OR this with the many-to-many `managedBy`
  /// relation below, so any manager in either set sees the rep's pipeline.
  /// Admin-curated via the team-members picker; the first ticked manager
  /// becomes the primary, additional ones go in the join table.
  managerId        String?
  manager          CrmUserProfile? @relation("CrmManagerReports", fields: [managerId], references: [id])
  reports          CrmUserProfile[] @relation("CrmManagerReports")

  /// Many-to-many team membership: a rep can be on multiple managers' teams
  /// at once (e.g. a senior AE shared between a regional VP and a product
  /// specialist). The admin "Team members" picker syncs this — adding a
  /// tick inserts a row, unticking deletes it. Visibility for the pipeline
  /// + cold leads + dashboards ORs this against `managerId` so legacy data
  /// keeps working until everything has been migrated to the join table.
  managedBy        CrmTeamMembership[] @relation("CrmTeamMembershipRep")
  manages          CrmTeamMembership[] @relation("CrmTeamMembershipManager")

  /// Optional explicit link to the user's HR employee record. When set,
  /// commission liability rolls into payroll automatically and the
  /// org-chart-derived team-lead authority on the HR side picks up the rep
  /// without relying on email-coincidence matching. Set by the unified
  /// user-creation form when both HR + CRM modules are selected.
  hrEmployeeId     String?     @unique
  hrEmployee       HrEmployee? @relation("CrmProfileToHrEmployee", fields: [hrEmployeeId], references: [id])

  // CRM relations
  ownedOpportunities    CrmOpportunity[] @relation("CrmOpportunityOwner")
  deliveryOpportunities CrmOpportunity[] @relation("CrmDeliveryOwner")
  techSupportOpps       CrmOpportunity[] @relation("CrmTechSupport")
  assignedCompanies     CrmCompany[]
  calls                 CrmCall[]
  meetings              CrmMeeting[]     @relation("CrmMeetingScheduler")
  approvedMeetings      CrmMeeting[]     @relation("CrmMeetingApprover")
  dailyReports          CrmDailyReport[] @relation("CrmDailyReportRep")
  assignedColdLeads     CrmColdLead[]    @relation("CrmColdLeadAssignee")
  coldLeadImports       CrmColdLeadImport[] @relation("CrmColdLeadImporter")
  coldLeadDispositions  CrmColdLeadDisposition[] @relation("CrmColdLeadDispositioner")
  activityLogs          CrmActivityLog[]
  notes                 CrmNote[]
  savedViews            CrmSavedView[]   @relation("CrmSavedViewOwner")
  quotas                CrmQuota[]       @relation("CrmQuotaRep")
  capacity              CrmRepCapacity?  @relation("CrmRepCapacity")
  forecastSubmissions   CrmForecastSubmission[] @relation("CrmForecastManager")
  dashboards            CrmDashboard[]   @relation("CrmDashboardOwner")
  authoredComments      CrmOpportunityComment[]          @relation("CrmCommentAuthor")
  commentMentions       CrmOpportunityCommentMention[]   @relation("CrmCommentMentions")
  actingAdminComments   CrmOpportunityComment[]          @relation("CrmCommentActingAdmin")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([entityId])
  @@index([role])
  @@map("crm_user_profiles")
}

/// Many-to-many manager↔rep join. One row per (manager, rep) pair — admins
/// add entries via the team-members picker. A rep can be on multiple
/// managers' teams. Both relations cascade-delete so dropping a user
/// doesn't leave dangling rows. Distinct from `CrmUserProfile.managerId`
/// (which is the single "primary" reporting line kept for back-compat);
/// visibility queries OR both.
model CrmTeamMembership {
  id        String         @id @default(cuid())
  managerId String
  manager   CrmUserProfile @relation("CrmTeamMembershipManager", fields: [managerId], references: [id], onDelete: Cascade)
  repId     String
  rep       CrmUserProfile @relation("CrmTeamMembershipRep", fields: [repId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())

  @@unique([managerId, repId])
  @@index([repId])
  @@map("crm_team_memberships")
}

// ============================================================================
// CRM MODULE — Entity (B Group subsidiaries)
// ============================================================================

model CrmEntity {
  id     String  @id @default(cuid())
  code   String  @unique
  nameEn String
  nameAr String
  color  String
  active Boolean @default(true)

  users         CrmUserProfile[]
  opportunities CrmOpportunity[]
  products      CrmProduct[]
  lossReasons   CrmLossReason[]
  stageConfigs  CrmStageConfig[]
  leadSources   CrmLeadSource[]

  @@map("crm_entities")
}

// ============================================================================
// CRM MODULE — Companies & Contacts
// ============================================================================

model CrmCompany {
  id           String           @id @default(cuid())
  nameEn       String
  nameAr       String?
  brandName    String?
  industry     String?
  website      String?
  phone        String?
  address      String?
  country      String           @default("EG")
  city         String?
  category     CrmClientCategory?
  notes        String?
  assignedToId String?
  assignedTo   CrmUserProfile?  @relation(fields: [assignedToId], references: [id])
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  contacts      CrmContact[]
  opportunities CrmOpportunity[]
  calls         CrmCall[]
  meetings      CrmMeeting[]

  @@index([assignedToId])
  @@index([country])
  @@index([category])
  @@map("crm_companies")
}

model CrmContact {
  id        String   @id @default(cuid())
  companyId String
  company   CrmCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fullName  String
  role      String?
  email     String?
  phone     String?
  whatsapp  String?
  isPrimary Boolean  @default(false)
  linkedIn  String?
  notes     String?
  createdAt DateTime @default(now())

  opportunities CrmOpportunity[] @relation("CrmPrimaryContact")

  @@index([companyId])
  @@index([email])
  @@map("crm_contacts")
}

// ============================================================================
// CRM MODULE — Opportunities
// ============================================================================

model CrmOpportunity {
  id               String              @id @default(cuid())
  code             String              @unique
  /// Customer company name as free text. The "company" on a sales opp is
  /// the prospect's company — we don't manage a directory of prospects.
  /// Reps type the name when they create the opp; managers can search /
  /// group by it later. Kept alongside the legacy `companyId` for now so
  /// historical rows continue to render through the existing relation.
  customerCompanyName String?
  /// Free-text contact info captured directly on the opp. Reps almost
  /// always know "the person they're talking to" before they know which
  /// CrmContact record (if any) they'd attach. Storing it here keeps the
  /// rep moving — managers can normalise into the curated CrmContact
  /// directory later if they want to.
  customerContactName  String?
  customerContactPhone String?
  customerContactEmail String?
  companyId        String?
  company          CrmCompany?         @relation(fields: [companyId], references: [id])
  primaryContactId String?
  primaryContact   CrmContact?         @relation("CrmPrimaryContact", fields: [primaryContactId], references: [id])
  ownerId          String
  owner            CrmUserProfile      @relation("CrmOpportunityOwner", fields: [ownerId], references: [id])
  entityId         String
  entity           CrmEntity           @relation(fields: [entityId], references: [id])

  title            String
  /// Stage is a free-text code, not a Prisma enum, so admins can add new
  /// stages from /crm/admin/stage-config without a schema migration. The
  /// `CrmStageConfig` table is the source of truth for which stages exist,
  /// their probabilities, and their display order. The canonical seed gives
  /// you NEW / CONTACTED / DISCOVERY / QUALIFIED / TECH_MEETING /
  /// PROPOSAL_SENT / NEGOTIATION / VERBAL_YES / WON / LOST / POSTPONED but
  /// nothing stops the admin from adding "PILOT" or renaming any of these.
  stage            String              @default("NEW")
  priority         CrmPriority         @default(COLD)
  leadSource       String?
  dealType         CrmDealType         @default(ONE_TIME)

  // Financial
  estimatedValue    Decimal  @db.Decimal(14, 2)
  currency          CrmCurrency @default(EGP)
  estimatedValueEGP Decimal  @db.Decimal(14, 2)
  probabilityPct    Int
  weightedValueEGP  Decimal  @db.Decimal(14, 2)

  // Product linkage
  products CrmOpportunityProduct[]
  /// Repeatable contact roster — one opp can have any number of contacts
  /// (decision maker, technical lead, procurement, etc.). The legacy
  /// `customerContact*` columns above still hold the single "headline"
  /// contact for backwards-compat with rows created before the join
  /// existed; new contacts always go here. Cascade-deletes with the opp.
  contacts CrmOpportunityContact[]
  /// Tier-1 #11 — MEDDPICC qualification snapshot (1:1). Created
  /// lazily on first save from the opp detail page.
  meddpicc CrmOpportunityMeddpicc?
  /// Tier-1 #23 — mutual action plan (1:1).
  closePlan CrmClosePlan?
  /// Tier-1 #27 — competitors many-to-many.
  competitors CrmOpportunityCompetitor[]
  /// In-opp discussion thread (1:N) — see CrmOpportunityComment.
  comments    CrmOpportunityComment[]
  /// Tier-2 #31 — which pipeline this opp belongs to. Null = default.
  pipelineId String?
  pipeline   CrmPipeline? @relation(fields: [pipelineId], references: [id], onDelete: SetNull)
  /// Tier-2 #37 — custom-field values keyed by CrmCustomFieldDef.slug.
  /// Shape: `{ "industry_tier": "A", "expected_arr": 50000 }`. Values
  /// are validated server-side against the field's `definition` JSON
  /// at write time.
  customValuesJson Json?
  /// Tier-1 #28 — manager's per-opp forecast-category override on top
  /// of the stage default. Lets a manager pin a deal to Commit even
  /// though its stage maps to BestCase, for example.
  forecastCategoryOverride String?
  /// Tier-2 #40 — slippage history (one row per expectedCloseDate change).
  closeDateHistory CrmCloseDateHistory[]

  // Timeline
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  dateContacted     DateTime?
  dateDiscovery     DateTime?
  dateProposalSent  DateTime?
  expectedCloseDate DateTime?
  dateClosed        DateTime?
  deliveryStartDate DateTime?

  // People
  techSupportId   String?
  techSupport     CrmUserProfile? @relation("CrmTechSupport", fields: [techSupportId], references: [id])
  deliveryOwnerId String?
  deliveryOwner   CrmUserProfile? @relation("CrmDeliveryOwner", fields: [deliveryOwnerId], references: [id])

  // Next step discipline
  nextAction     CrmNextActionType?
  nextActionText String?
  nextActionDate DateTime?

  // Close / Loss
  lossReasonId     String?
  lossReason       CrmLossReason? @relation(fields: [lossReasonId], references: [id])
  lostToCompetitor String?

  // Documents
  proposalUrl String?
  contractUrl String?

  // Cold-lead → opportunity link, set when a rep converts an imported lead.
  convertedFromColdLead CrmColdLead? @relation("CrmColdLeadConverted")

  // Notes & Context
  description      String?
  techRequirements String?

  // External sync
  notionPageId String? @unique

  // Audit
  stageChanges CrmStageHistory[]
  calls        CrmCall[]
  meetings     CrmMeeting[]
  notes        CrmNote[]
  activityLogs CrmActivityLog[]
  attachments  CrmAttachment[]

  /// Soft-delete marker. When non-null, the opportunity is hidden from every
  /// list but its audit trail (CrmStageHistory, CrmActivityLog, CrmAttachment)
  /// is preserved. Restorable by an admin until it's purged after the
  /// retention window. Every findMany query must filter `deletedAt: null`.
  deletedAt   DateTime?
  deletedById String?

  @@index([companyId])
  @@index([ownerId])
  @@index([entityId])
  @@index([stage])
  @@index([priority])
  @@index([expectedCloseDate])
  @@index([nextActionDate])
  @@index([deletedAt])
  @@map("crm_opportunities")
}

model CrmOpportunityProduct {
  id            String         @id @default(cuid())
  opportunityId String
  opportunity   CrmOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  productId     String
  product       CrmProduct     @relation(fields: [productId], references: [id])
  quantity      Decimal        @default(1) @db.Decimal(10, 2)
  unitPriceEGP  Decimal        @db.Decimal(14, 2)
  discountPct   Decimal        @default(0) @db.Decimal(5, 2)

  @@unique([opportunityId, productId])
  @@map("crm_opportunity_products")
}

/// Tier-1 #11 — MEDDPICC qualification snapshot for one opportunity.
/// One-to-one with CrmOpportunity. Each of the 8 letters gets a 0-3
/// score (none / weak / decent / strong) so we can roll up a deal-
/// health number, plus a free-text "notes" field per letter for the
/// rep to capture context ("Champion: Hala in procurement, met 3x").
/// Stored normalised (not as JSON on the opp) so historical snapshots
/// can be exported, audit trails work via Prisma's standard log
/// patterns, and per-field reporting (which letters are weakest in
/// our funnel?) is just a normal aggregate. `null` score means
/// "not assessed yet" so we don't conflate "explicitly bad" with
/// "haven't asked yet".
model CrmOpportunityMeddpicc {
  id            String         @id @default(cuid())
  opportunityId String         @unique
  opportunity   CrmOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  metricsScore           Int?
  metricsNotes           String?
  economicBuyerScore     Int?
  economicBuyerNotes     String?
  decisionCriteriaScore  Int?
  decisionCriteriaNotes  String?
  decisionProcessScore   Int?
  decisionProcessNotes   String?
  paperProcessScore      Int?
  paperProcessNotes      String?
  identifyPainScore      Int?
  identifyPainNotes      String?
  championScore          Int?
  championNotes          String?
  competitionScore       Int?
  competitionNotes       String?
  updatedAt     DateTime       @updatedAt
  createdAt     DateTime       @default(now())

  @@map("crm_opportunity_meddpicc")
}

/// One row per contact person on an opportunity. Free-text (not FK'd to
/// CrmContact) because reps capture contacts inline during the deal — the
/// curated CrmContact directory is admin-managed and only covers companies
/// we explicitly maintain. The CRM Contacts page surfaces both: directory
/// rows AND these opp-level rows, deduped by phone/email at the read
/// site. `role` is free text ("Decision maker", "Technical lead", etc.).
/// Cascade-deletes when the parent opp is hard-deleted.
model CrmOpportunityContact {
  id            String         @id @default(cuid())
  opportunityId String
  opportunity   CrmOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  name          String
  role          String?
  phone         String?
  email         String?
  whatsapp      String?
  isPrimary     Boolean        @default(false)
  notes         String?
  /// Tier-1 #12 — stakeholder role + influence + sentiment. `roleType`
  /// is one of: Champion / EconomicBuyer / DecisionMaker / Influencer
  /// / Blocker / EndUser / Coach (free text so admins can extend).
  /// `influence` 1-5 (low to high). `sentiment` "For" / "Neutral" /
  /// "Against". All nullable so existing contact rows stay valid.
  roleType   String?
  influence  Int?
  sentiment  String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([opportunityId])
  @@index([email])
  @@index([phone])
  @@map("crm_opportunity_contacts")
}

/// Tier-1 #15 + #17 — per-rep capacity + routing weight.
/// `maxOpenLeads` caps how many ASSIGNED + NO_ANSWER cold leads a rep
/// can hold; routing skips reps over the cap. `routingWeight` is the
/// round-robin weight (1 = default, 2 = senior gets twice as many,
/// 0.5 = ramping new hire gets half). Implemented as a separate
/// table rather than columns on CrmUserProfile so the schema doesn't
/// bloat for the 95% of installs that don't need either knob.
model CrmRepCapacity {
  id            String         @id @default(cuid())
  repId         String         @unique
  rep           CrmUserProfile @relation("CrmRepCapacity", fields: [repId], references: [id], onDelete: Cascade)
  maxOpenLeads  Int?
  routingWeight Float          @default(1.0)
  skillTags     String[]       @default([])
  pausedUntil   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@map("crm_rep_capacities")
}

/// Tier-1 #16 — per-status recycle policy. When a lead stays in a
/// "stuck" status (NO_ANSWER, WAITING_LIST, NOT_INTERESTED) past the
/// cooldown OR has been recycled `maxAttempts` times, the recycle
/// job moves it to ARCHIVED — or back to the unassigned pool, per
/// `recycleTarget`.
model CrmLeadRecyclePolicy {
  id            String            @id @default(cuid())
  status        CrmColdLeadStatus @unique
  cooldownDays  Int
  maxAttempts   Int               @default(3)
  recycleTarget String            @default("unassigned-pool") // "unassigned-pool" | "archive" | "original-rep"
  active        Boolean           @default(true)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@map("crm_lead_recycle_policies")
}

/// Tier-1 #23 — mutual action plan (close plan). One per opp, with
/// repeatable items. Public `shareToken` lets the buyer view a
/// read-only version without a CRM login.
model CrmClosePlan {
  id            String              @id @default(cuid())
  opportunityId String              @unique
  opportunity   CrmOpportunity      @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  title         String              @default("Mutual Action Plan")
  shareToken    String?             @unique
  items         CrmClosePlanItem[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@map("crm_close_plans")
}

model CrmClosePlanItem {
  id           String        @id @default(cuid())
  planId       String
  plan         CrmClosePlan  @relation(fields: [planId], references: [id], onDelete: Cascade)
  title        String
  ownerSide    String        @default("us") // "us" | "them"
  dueDate      DateTime?
  status       String        @default("open") // open | done | blocked
  orderIndex   Int           @default(0)
  notes        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([planId])
  @@map("crm_close_plan_items")
}

/// Tier-1 #24 — admin-attached playbook content per stage. Rich
/// markdown / HTML the rep sees inline on the opp sidebar when the
/// opp is in that stage.
model CrmStagePlaybook {
  id        String   @id @default(cuid())
  stage     String   @unique
  bodyMd    String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("crm_stage_playbooks")
}

/// Tier-1 #25 — activity quotas per stage (calls / meetings within N
/// days before the opp is allowed to leave the stage). Admin-defined,
/// validated in `changeStage` alongside required-fields gating.
model CrmStageActivityQuota {
  id           String  @id @default(cuid())
  stage        String
  activityType String  // "call" | "meeting" | "email"
  minCount     Int
  windowDays   Int     @default(30)
  active       Boolean @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([stage, activityType])
  @@map("crm_stage_activity_quotas")
}

/// Tier-1 #27 — admin-curated competitor list + per-opp many-to-many.
model CrmCompetitor {
  id        String                      @id @default(cuid())
  name      String                      @unique
  active    Boolean                     @default(true)
  notes     String?
  createdAt DateTime                    @default(now())
  opps      CrmOpportunityCompetitor[]

  @@map("crm_competitors")
}

model CrmOpportunityCompetitor {
  id            String         @id @default(cuid())
  opportunityId String
  opportunity   CrmOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  competitorId  String
  competitor    CrmCompetitor  @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  wasPrimary    Boolean        @default(false)
  createdAt     DateTime       @default(now())

  @@unique([opportunityId, competitorId])
  @@index([opportunityId])
  @@map("crm_opportunity_competitors")
}

/// In-opp discussion thread. Reps and managers leave comments on a
/// specific opportunity, optionally @-mentioning each other. Each
/// mention writes a CrmNotification row so the mentioned user sees
/// "X mentioned you on <opp>" in the bell.
///
/// The body is plain text with `@<crmProfileId>` tokens for mentions
/// (so renames don't break old comments — we resolve to the live
/// profile at render time). The client renders these as linked chips.
model CrmOpportunityComment {
  id            String                          @id @default(cuid())
  opportunityId String
  opportunity   CrmOpportunity                  @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  authorId      String
  author        CrmUserProfile                  @relation("CrmCommentAuthor", fields: [authorId], references: [id])
  /// Tier-1 #30 — when the row was written under impersonation, this
  /// carries the admin's CrmUserProfile.id. authorId still records
  /// the target (so REP-scope queries / mention authorship still see
  /// the user the impersonator acted as), and audit-log surfaces can
  /// reveal the admin behind the action via this field.
  actingAdminId String?
  actingAdmin   CrmUserProfile?                 @relation("CrmCommentActingAdmin", fields: [actingAdminId], references: [id])
  body          String
  mentions      CrmOpportunityCommentMention[]
  /// Edited comments stamp `editedAt`; deletes are soft (deletedAt)
  /// so the audit trail stays intact.
  editedAt      DateTime?
  deletedAt     DateTime?
  createdAt     DateTime                        @default(now())
  updatedAt     DateTime                        @updatedAt

  @@index([opportunityId, createdAt])
  @@index([authorId])
  @@map("crm_opportunity_comments")
}

model CrmOpportunityCommentMention {
  id              String                @id @default(cuid())
  commentId       String
  comment         CrmOpportunityComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  /// CrmUserProfile id of the mentioned user. We mention by CRM
  /// profile (not User.id) because the dropdown picker only knows
  /// CRM users — every mention is in the CRM scope.
  mentionedUserId String
  mentioned       CrmUserProfile        @relation("CrmCommentMentions", fields: [mentionedUserId], references: [id])
  createdAt       DateTime              @default(now())

  @@unique([commentId, mentionedUserId])
  @@index([mentionedUserId])
  @@map("crm_opportunity_comment_mentions")
}

/// CRM-side notification bucket. Mirrors HrNotification +
/// PartnerNotification so the unified /api/notifications endpoint
/// fans out to all three modules. Today's only producer is comment
/// mentions on opps; future producers (workflow notify-in-app,
/// alert-rule fan-out, lead-SLA reminders) will append rows here
/// rather than reusing CrmActivityLog (which is a hard audit log,
/// not user-targeted).
model CrmNotification {
  id        String   @id @default(cuid())
  /// Auth User id (NOT crmProfile id) — keeps it consistent with
  /// HrNotification + PartnerNotification so the unified read
  /// endpoint can dispatch by `session.user.id`.
  userId    String
  type      String   /// e.g. "mention", "comment_reply", future kinds
  title     String
  message   String
  isRead    Boolean  @default(false)
  /// Where the bell click should navigate (e.g. "/crm/opportunities/<id>").
  href      String?
  /// Arbitrary blob — `{ opportunityId, commentId, mentionedById }`
  /// for mentions.
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@map("crm_notifications")
}

/// Tier-1 #28 — manager forecast submission overlay. One row per
/// (manager, period, category) — the manager's judgement on what
/// they'll actually deliver, alongside the system roll-up.
model CrmForecastSubmission {
  id              String         @id @default(cuid())
  managerId       String
  manager         CrmUserProfile @relation("CrmForecastManager", fields: [managerId], references: [id], onDelete: Cascade)
  periodKey       String         // YYYY-MM for monthly, YYYY-Q1 for quarterly
  commitEGP       Decimal        @db.Decimal(14, 2)
  bestCaseEGP     Decimal        @db.Decimal(14, 2)
  notes           String?
  submittedAt     DateTime       @default(now())

  @@unique([managerId, periodKey])
  @@index([periodKey])
  @@map("crm_forecast_submissions")
}

model CrmStageHistory {
  id            String               @id @default(cuid())
  opportunityId String
  opportunity   CrmOpportunity       @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  /// Matches CrmOpportunity.stage — String, not enum, so the audit trail
  /// can record transitions involving admin-added stages.
  fromStage     String?
  toStage       String
  changedAt     DateTime             @default(now())
  changedById   String
  /// CrmUserProfile.id of the admin behind the action when the
  /// stage change happened under impersonation. changedById still
  /// records the target (so visibility / authorship is consistent
  /// with the rest of the audit trail), and this column reveals
  /// who actually initiated.
  actingAdminId String?
  durationDays  Int?

  @@index([opportunityId])
  @@map("crm_stage_histories")
}

// ============================================================================
// CRM MODULE — Call Log
// ============================================================================

model CrmCall {
  id            String          @id @default(cuid())
  code          String          @unique
  opportunityId String?
  opportunity   CrmOpportunity? @relation(fields: [opportunityId], references: [id])
  companyId     String?
  company       CrmCompany?     @relation(fields: [companyId], references: [id])
  contactId     String?
  contactName   String?
  callerId      String
  caller        CrmUserProfile  @relation(fields: [callerId], references: [id])
  /// CrmUserProfile.id of the admin behind the action when the call
  /// was logged under impersonation. callerId is the target; this
  /// column reveals the admin behind the action.
  actingAdminId String?

  callType       CrmCallType
  outcome        CrmCallOutcome
  durationMins   Int            @default(0)
  callAt         DateTime       @default(now())
  nextActionText String?
  nextActionDate DateTime?
  notes          String?

  @@index([callerId, callAt])
  @@index([opportunityId])
  @@index([companyId])
  @@index([contactId])
  @@map("crm_calls")
}

// ============================================================================
// CRM MODULE — Daily reports (replaces ad-hoc call logging)
// ============================================================================

model CrmDailyReport {
  id              String         @id @default(cuid())
  repId           String
  rep             CrmUserProfile @relation("CrmDailyReportRep", fields: [repId], references: [id])
  /// Calendar day this report covers (UTC midnight).
  reportDate      DateTime
  callsCount      Int            @default(0)
  meetingsBooked  Int            @default(0)
  meetingsHeld    Int            @default(0)
  newLeads        Int            @default(0)
  notes           String         @default("")
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([repId, reportDate])
  @@index([reportDate])
  @@map("crm_daily_reports")
}

// ============================================================================
// CRM MODULE — Technical Meeting Booking
// ============================================================================

enum CrmMeetingType {
  DEMO
  OFFICE_VISIT
  FOLLOWUP
  PROPOSAL
  ONBOARDING
}

enum CrmMeetingStatus {
  /// The sales rep has booked the slot but the meeting is not yet approved.
  /// Lives in the assistant's queue until they confirm with the tech team.
  PENDING_APPROVAL
  /// Legacy alias for PENDING_APPROVAL — kept for existing data; new rows
  /// should use PENDING_APPROVAL going forward.
  WAITING
  /// Assistant has approved the booking; sales rep can now confirm with client.
  APPROVED
  /// Assistant has denied the booking (tech team unavailable, conflict, etc.).
  DENIED
  /// Final state — meeting confirmed with client and held.
  CONFIRMED
  DONE
  CANCELLED
}

model CrmMeeting {
  id              String           @id @default(cuid())
  code            String           @unique
  /// Optional linked opportunity / company.
  opportunityId   String?
  opportunity     CrmOpportunity?  @relation(fields: [opportunityId], references: [id])
  companyId       String?
  company         CrmCompany?      @relation(fields: [companyId], references: [id])
  contactName     String?
  contactPhone    String?
  /// Sales rep who booked the meeting (and whose slot is "occupied" by it).
  scheduledById   String
  scheduledBy     CrmUserProfile   @relation("CrmMeetingScheduler", fields: [scheduledById], references: [id])
  /// CrmUserProfile.id of the admin when the meeting was booked
  /// under impersonation. scheduledById is the target; this column
  /// reveals the admin behind the action.
  actingAdminId   String?

  startAt         DateTime
  endAt           DateTime
  durationMinutes Int
  meetingType     CrmMeetingType   @default(DEMO)
  customerNeed    String?
  notes           String?
  status          CrmMeetingStatus @default(PENDING_APPROVAL)

  /// Assistant approval workflow — a booked meeting starts PENDING_APPROVAL.
  /// The assistant checks with the tech team and approves/denies. Sales reps
  /// can't confirm with the client until approvedAt is set.
  approvedById    String?
  approvedBy      CrmUserProfile?  @relation("CrmMeetingApprover", fields: [approvedById], references: [id])
  approvedAt      DateTime?
  /// On denial, the assistant leaves a reason so the rep knows what to fix
  /// (tech-team conflict, no engineer with X skill, room booked, etc.).
  deniedReason    String?
  deniedAt        DateTime?

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([scheduledById, startAt])
  @@index([startAt])
  @@index([status])
  @@index([approvedById])
  @@map("crm_meetings")
}

// ============================================================================
// CRM MODULE — Products
// ============================================================================

model CrmProduct {
  id            String      @id @default(cuid())
  code          String      @unique
  entityId      String
  entity        CrmEntity   @relation(fields: [entityId], references: [id])
  category      String
  nameEn        String
  nameAr        String
  description   String?
  descriptionAr String?
  basePrice     Decimal     @db.Decimal(14, 2)
  currency      CrmCurrency
  dealType      CrmDealType
  active        Boolean     @default(true)

  opportunities CrmOpportunityProduct[]

  @@index([entityId, category])
  @@index([active])
  @@map("crm_products")
}

// ============================================================================
// CRM MODULE — Notes & Activity
// ============================================================================

model CrmNote {
  id            String          @id @default(cuid())
  opportunityId String?
  opportunity   CrmOpportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  companyId     String?
  authorId      String
  author        CrmUserProfile  @relation(fields: [authorId], references: [id])
  /// Admin's CrmUserProfile.id when the note was written under
  /// impersonation (authorId is the impersonation target).
  actingAdminId String?
  content       String          @db.Text
  createdAt     DateTime        @default(now())

  @@index([opportunityId])
  @@index([companyId])
  @@map("crm_notes")
}

model CrmActivityLog {
  id            String          @id @default(cuid())
  opportunityId String?
  opportunity   CrmOpportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  actorId       String
  actor         CrmUserProfile  @relation(fields: [actorId], references: [id])
  /// Admin's CrmUserProfile.id when the action was performed under
  /// impersonation. actorId is the impersonation target; this is the
  /// admin behind the action. Null on regular self-acted rows.
  actingAdminId String?
  action        String
  metadata      Json?
  createdAt     DateTime        @default(now())

  @@index([opportunityId, createdAt])
  @@index([actorId, createdAt])
  @@map("crm_activity_logs")
}

model CrmAttachment {
  id            String            @id @default(cuid())
  opportunityId String
  opportunity   CrmOpportunity    @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  filename      String
  url           String
  sizeBytes     Int
  mimeType      String
  kind          CrmAttachmentKind
  uploadedById  String
  createdAt     DateTime          @default(now())

  @@map("crm_attachments")
}

// ============================================================================
// CRM MODULE — Configuration Tables
// ============================================================================

model CrmStageConfig {
  id             String              @id @default(cuid())
  entityId       String?
  entity         CrmEntity?          @relation(fields: [entityId], references: [id])
  /// Free-text stage code (NEW / CONTACTED / PILOT / whatever the admin adds).
  stage          String
  /// Soft-delete flag: admins can hide a stage from the pipeline without
  /// dropping the underlying enum value (which would break historical data).
  /// Stages with isActive=false don't appear in the dropdown / kanban.
  isActive       Boolean             @default(true)
  /// Optional override of the enum's default label, per locale. Lets the
  /// admin rename "TECH_MEETING" to "Discovery call", etc., without code
  /// changes. Null falls back to the static stage-labels translation file.
  customLabelEn  String?
  customLabelAr  String?
  probabilityPct Int
  slaHours       Int?
  displayOrder   Int
  /// Tier-0 item 2 — stage semantics. `stageType` lets reports stop
  /// hard-coding `stage === "WON"`, and `forecastCategory` powers a
  /// Salesforce-style commit/best-case roll-up on top of the existing
  /// weighted pipeline. Both default to "open"/"pipeline" so existing
  /// rows behave the same as today until an admin re-categorises them.
  stageType        String?  @default("open")   // open | won | lost | abandoned
  forecastCategory String?  @default("pipeline") // pipeline | bestCase | commit | closed | omitted
  /// Tier-0 item 3 — stalled-deal detection. Computed against
  /// CrmStageHistory entries: if `now - lastChangedAt > maxDays` the
  /// opp shows a "stalled X days" badge on the kanban card and a
  /// "stuck deals" widget on the group dashboard.
  targetDays Int?
  maxDays    Int?
  /// Tier-0 item 1 — required-fields gating. JSON list of opportunity
  /// field paths that must be non-null before an opp can EXIT this
  /// stage (drag-drop or stage change). Shape: `["estimatedValue",
  /// "nextActionDate", "primaryContactId"]`. Empty/null = no gate
  /// (current behaviour). Enforced server-side in `changeStage`.
  requiredFieldsJson Json?
  /// Tier-2 #31 — which pipeline this stage belongs to. Null = legacy
  /// default pipeline (rows created before the migration).
  pipelineId String?
  pipeline   CrmPipeline? @relation(fields: [pipelineId], references: [id], onDelete: SetNull)

  @@unique([entityId, stage])
  @@map("crm_stage_configs")
}

/// Tier-1 #30 — admin "act as" / impersonation. One active session
/// per admin (unique on adminUserId). The auth JWT callback looks
/// for a row keyed by the actually-signed-in user; if present, the
/// downstream session reports the TARGET user but tags `actingAs`
/// with the admin's id so the banner can render "Return to admin".
///
/// Audit trail: start/stop both write CrmImpersonationAudit rows.
model CrmImpersonationSession {
  id           String   @id @default(cuid())
  adminUserId  String   @unique
  targetUserId String
  startedAt    DateTime @default(now())
  reason       String?

  @@map("crm_impersonation_sessions")
}

model CrmImpersonationAudit {
  id           String   @id @default(cuid())
  adminUserId  String
  targetUserId String
  event        String
  reason       String?
  ipAddress    String?
  at           DateTime @default(now())

  @@index([adminUserId])
  @@index([targetUserId])
  @@map("crm_impersonation_audits")
}

/// Tier-2 #34 — configurable lead status state machine. Replaces the
/// hardcoded transitions enforced today in the disposition endpoint.
/// One row per allowed (from, to) pair. Empty table = anything goes
/// (back-compat for installs that haven't configured it).
model CrmLeadStatusTransition {
  id              String            @id @default(cuid())
  fromStatus      CrmColdLeadStatus
  toStatus        CrmColdLeadStatus
  requiresReason  Boolean           @default(false)
  allowedRoles    String[]          @default([])
  active          Boolean           @default(true)
  createdAt       DateTime          @default(now())

  @@unique([fromStatus, toStatus])
  @@map("crm_lead_status_transitions")
}

/// Tier-2 #36 — workflow / automation engine. Admin builds:
///   trigger    event description (e.g. "opp.stage.changed",
///              "lead.assignedAt.elapsed", "schedule.cron")
///   condition  JSON predicate evaluated against the trigger payload
///   action     JSON describing what to do (create task, set field,
///              POST webhook, send email, reassign, etc.)
///
/// `suppressionWindowMinutes` prevents re-firing on the same entity
/// within the window (default 1440 = 24h) so alert fatigue stays in
/// check. `lastFiredAt` is the runtime bookkeeping.
model CrmWorkflow {
  id                      String   @id @default(cuid())
  name                    String
  description             String?
  triggerKind             String
  triggerConfig           Json?
  conditionJson           Json?
  actionJson              Json
  suppressionWindowMinutes Int     @default(1440)
  isActive                Boolean  @default(true)
  lastFiredAt             DateTime?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  runs                    CrmWorkflowRun[]

  @@index([triggerKind])
  @@map("crm_workflows")
}

model CrmWorkflowRun {
  id          String      @id @default(cuid())
  workflowId  String
  workflow    CrmWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  status      String      // queued | running | success | failed | suppressed
  entityType  String?
  entityId    String?
  payloadJson Json?
  resultJson  Json?
  error       String?
  firedAt     DateTime    @default(now())
  finishedAt  DateTime?

  @@index([workflowId, firedAt])
  @@index([entityId])
  @@map("crm_workflow_runs")
}

/// Tier-2 #38 — saved dashboard layouts. Each dashboard is a list of
/// widget configs (the renderer maps `kind` → React component). One
/// row per (owner, name). Sharing model mirrors CrmSavedView.
model CrmDashboard {
  id        String         @id @default(cuid())
  ownerId   String
  owner     CrmUserProfile @relation("CrmDashboardOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  name      String
  layoutJson Json          // array of { kind, params, x, y, w, h }
  isShared  Boolean        @default(false)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([ownerId])
  @@map("crm_dashboards")
}

/// Tier-2 #39 — alert rules engine. Each rule is a saved query +
/// notification config. The nightly evaluator scans against
/// `predicateJson` and notifies matching opps once per `suppressionDays`.
model CrmAlertRule {
  id              String   @id @default(cuid())
  name            String
  scope           String   // "opportunity" | "coldLead"
  predicateJson   Json     // structured filter: { field, op, value }[]
  channels        String[] @default(["in-app"])
  suppressionDays Int      @default(1)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("crm_alert_rules")
}

/// Tier-2 #40 — slippage tracking. Every change to
/// `expectedCloseDate` writes a row here so admins can run "deals
/// slipped > 30 days cumulative" reports.
model CrmCloseDateHistory {
  id            String         @id @default(cuid())
  opportunityId String
  opportunity   CrmOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  oldDate       DateTime?
  newDate       DateTime?
  changedAt     DateTime       @default(now())
  changedById   String

  @@index([opportunityId])
  @@map("crm_close_date_history")
}

/// Tier-2 #43 — rejected rows from CSV / Excel imports. Each row is
/// a single rejected lead with the original row data + the reason it
/// was blocked. Admin re-reviews from this queue and bulk re-imports
/// the cleaned set.
model CrmColdLeadImportReject {
  id            String   @id @default(cuid())
  importBatchId String?
  rowNumber     Int
  rawJson       Json
  reason        String
  createdAt     DateTime @default(now())

  @@index([importBatchId])
  @@map("crm_cold_lead_import_rejects")
}

/// Tier-2 #31 — multiple named pipelines. Each pipeline has its own
/// stages (CrmStageConfig.pipelineId references this), probabilities,
/// rotting thresholds, required-field gates. The default pipeline
/// holds existing rows when `pipelineId` is null on either side so
/// upgrades don't break anything.
///
///   kind = "new-business" | "renewal" | "expansion" | custom
///
/// `defaultForKind` lets one row per kind be the auto-target for new
/// opps of that kind (e.g. "auto-create renewal opp in this pipeline
/// when X closes WON").
model CrmPipeline {
  id              String   @id @default(cuid())
  name            String   @unique
  kind            String   @default("new-business")
  defaultForKind  Boolean  @default(false)
  isActive        Boolean  @default(true)
  displayOrder    Int      @default(0)
  description     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  stageConfigs CrmStageConfig[]
  opportunities CrmOpportunity[]

  @@map("crm_pipelines")
}

/// Tier-2 #37 — custom-fields meta-schema. Admin defines a typed
/// field per object (opportunity / contact / lead / company). The
/// `definition` JSON carries field-type-specific config (picklist
/// options, min/max for numbers, regex for text, etc.).
///
///   objectType  "opportunity" | "contact" | "coldLead" | "company"
///   kind        "text" | "number" | "picklist" | "date" | "boolean" | "lookup"
///   slug        snake_case identifier, unique per object
///
/// Values are stored on the corresponding entity via the matching
/// `customValuesJson` column (added in this migration to Opportunity,
/// Contact, Cold Lead, Company). One JSON column avoids N joins
/// per row read at the cost of slightly weaker queryability —
/// acceptable for an admin-defined schema where most queries are
/// against the core (non-custom) columns.
model CrmCustomFieldDef {
  id          String  @id @default(cuid())
  objectType  String
  slug        String
  label       String
  kind        String
  required    Boolean @default(false)
  definition  Json?
  displayOrder Int    @default(0)
  active      Boolean @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([objectType, slug])
  @@index([objectType])
  @@map("crm_custom_field_defs")
}

/// Tier-1 #18 — per-rep, per-period quota with ramping support. Replaces
/// the simple `monthlyTargetEGP` for orgs that want quarterly/annual
/// targets, ramped numbers for new hires, or split quotas (new business
/// vs. expansion). The legacy column stays as the default fallback for
/// reps without explicit quota rows.
///
///   period          "monthly" | "quarterly" | "annual"
///   periodStart     first day of the period (UTC midnight) — keys the row
///   amountEGP       the quota in EGP for the entire period
///   splitKind       optional: "new-business" / "expansion" / "all" (default)
///                   so the same rep can have multiple parallel quotas.
///   notes           free text for HR ("ramped 75% — month 2 of onboarding")
///
/// Unique on (repId, period, periodStart, splitKind) so re-setting a
/// quota replaces in place rather than stacking.
model CrmQuota {
  id          String         @id @default(cuid())
  repId       String
  rep         CrmUserProfile @relation("CrmQuotaRep", fields: [repId], references: [id], onDelete: Cascade)
  period      String
  periodStart DateTime
  amountEGP   Decimal        @db.Decimal(14, 2)
  splitKind   String         @default("all")
  notes       String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([repId, period, periodStart, splitKind])
  @@index([repId])
  @@index([periodStart])
  @@map("crm_quotas")
}

/// Tier-0 item 6 — saved smart views. Admin-curated, URL-shareable
/// filtered views on opportunities / cold-leads / contacts / calls.
/// `scope` is `"<module>:<resource>"` (e.g. "crm:opportunities") so the
/// same table serves every list page. `filtersJson` is the encoded
/// query-string parameters the list page already accepts (q, status,
/// owner, batchId, etc.) — applied client-side when a view is loaded.
/// `isShared = true` makes the view visible to every CRM user;
/// otherwise it's the creator's personal view. No team-level sharing
/// yet — kept simple for the first cut.
model CrmSavedView {
  id          String         @id @default(cuid())
  ownerId     String
  owner       CrmUserProfile @relation("CrmSavedViewOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  scope       String
  name        String
  filtersJson Json
  isShared    Boolean        @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([scope])
  @@index([ownerId])
  @@map("crm_saved_views")
}

/**
 * Customer-need taxonomy for meeting bookings & opportunity tagging.
 * The meeting form's "What does the customer need?" dropdown used to be a
 * hardcoded list (`["B-Clinics", "B-Optical", ...]`); admins now manage it
 * here so they can add/remove offerings without code changes.
 */
model CrmCustomerNeed {
  id        String   @id @default(cuid())
  labelEn   String
  labelAr   String   @default("")
  /// Optional grouping (e.g. "Healthcare" / "Tech"). Display-only.
  category  String   @default("")
  /// Inactive needs are hidden from the picker but preserved for historical
  /// rows that already reference them by label string.
  active    Boolean  @default(true)
  /// Lower = shown earlier in the dropdown.
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([labelEn])
  @@map("crm_customer_needs")
}

/**
 * Per-meeting-type display config. The underlying `CrmMeetingType` enum
 * doesn't change, but admins can rename labels (per locale), hide types
 * they don't run, and reorder them.
 */
model CrmMeetingTypeConfig {
  id        String   @id @default(cuid())
  /// Matches a CrmMeetingType enum value: DEMO / OFFICE_VISIT / FOLLOWUP /
  /// PROPOSAL / ONBOARDING. Stored as String so adding a new enum doesn't
  /// require a migration.
  code      String   @unique
  labelEn   String
  labelAr   String   @default("")
  active    Boolean  @default(true)
  sortOrder Int      @default(0)

  @@map("crm_meeting_type_configs")
}

model CrmLossReason {
  id       String     @id @default(cuid())
  code     String
  labelEn  String
  labelAr  String
  entityId String?
  entity   CrmEntity? @relation(fields: [entityId], references: [id])
  active   Boolean    @default(true)

  opportunities CrmOpportunity[]

  @@unique([entityId, code])
  @@map("crm_loss_reasons")
}

model CrmLeadSource {
  id       String     @id @default(cuid())
  code     String
  labelEn  String
  labelAr  String
  entityId String?
  entity   CrmEntity? @relation(fields: [entityId], references: [id])
  active   Boolean    @default(true)

  @@unique([entityId, code])
  @@map("crm_lead_sources")
}

model CrmFxRate {
  id        String      @id @default(cuid())
  currency  CrmCurrency @unique
  toEGP     Decimal     @db.Decimal(12, 4)
  updatedAt DateTime    @updatedAt

  @@map("crm_fx_rates")
}

model CrmSystemConfig {
  key   String @id
  value String

  @@map("crm_system_configs")
}

// ============================================================================
// PARTNERS MODULE — Enums
// ============================================================================

enum PartnerLeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  LOST
}

enum PartnerDealStatus {
  PENDING
  WON
  LOST
}

enum PartnerContractStatus {
  REQUESTED
  APPROVED
  REJECTED
}

enum PartnerInvoiceStatus {
  REQUESTED
  APPROVED
  REJECTED
}

enum PartnerCommissionStatus {
  PENDING
  APPROVED
  PAID
}

enum PartnerNotificationType {
  CONTRACT_APPROVED
  CONTRACT_REJECTED
  INVOICE_APPROVED
  INVOICE_REJECTED
  COMMISSION_APPROVED
  COMMISSION_PAID
  DEAL_WON
  GENERAL
}

// ============================================================================
// PARTNERS MODULE — Profile
// ============================================================================

model PartnerProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName    String
  contactPhone   String?
  commissionRate Float    @default(10)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  leads       PartnerLead[]
  clients     PartnerClient[]
  deals       PartnerDeal[]
  contracts   PartnerContract[]
  invoices    PartnerInvoice[]
  commissions PartnerCommission[]
  payouts     PartnerPayout[]

  @@map("partner_profiles")
}

// ============================================================================
// PARTNERS MODULE — Leads & Clients
// ============================================================================

model PartnerLead {
  id                  String            @id @default(cuid())
  partnerId           String
  partner             PartnerProfile    @relation(fields: [partnerId], references: [id])
  name                String
  email               String?
  phone               String?
  company             String?
  status              PartnerLeadStatus @default(NEW)
  notes               String?
  convertedToClientId String?           @unique
  convertedToClient   PartnerClient?    @relation("PartnerLeadConversion", fields: [convertedToClientId], references: [id])
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  /// Soft-delete marker. Hides the lead from default queries; preserves
  /// the audit trail of who-owned-it-when. Restorable.
  deletedAt           DateTime?
  deletedById         String?

  @@index([partnerId])
  @@index([status])
  @@index([partnerId, status])
  @@index([deletedAt])
  @@map("partner_leads")
}

model PartnerClient {
  id        String         @id @default(cuid())
  partnerId String
  partner   PartnerProfile @relation(fields: [partnerId], references: [id])
  name      String
  email     String?
  phone     String?
  company   String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  /// Soft-delete marker — same semantics as PartnerLead.
  deletedAt DateTime?
  deletedById String?

  convertedFromLead PartnerLead? @relation("PartnerLeadConversion")
  deals             PartnerDeal[]

  @@index([partnerId])
  @@index([deletedAt])
  @@map("partner_clients")
}

// ============================================================================
// PARTNERS MODULE — Services & Deals
// ============================================================================

model PartnerService {
  id          String   @id @default(cuid())
  name        String
  description String?
  basePrice   Float
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  deals PartnerDeal[]

  @@map("partner_services")
}

model PartnerDeal {
  id        String            @id @default(cuid())
  partnerId String
  partner   PartnerProfile    @relation(fields: [partnerId], references: [id])
  clientId  String
  client    PartnerClient     @relation(fields: [clientId], references: [id])
  serviceId String
  service   PartnerService    @relation(fields: [serviceId], references: [id])
  value     Float
  status    PartnerDealStatus @default(PENDING)
  notes     String?
  wonAt     DateTime?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  contracts  PartnerContract[]
  invoices   PartnerInvoice[]
  commission PartnerCommission?

  /// Soft-delete marker. Hides the deal from default lists; commission +
  /// contracts + invoices stay intact for audit + finance reconciliation.
  deletedAt DateTime?
  deletedById String?

  @@index([partnerId])
  @@index([clientId])
  @@index([serviceId])
  @@index([status])
  @@index([partnerId, status])
  @@index([deletedAt])
  @@map("partner_deals")
}

// ============================================================================
// PARTNERS MODULE — Contracts & Invoices
// ============================================================================

model PartnerContract {
  id              String                @id @default(cuid())
  partnerId       String
  partner         PartnerProfile        @relation(fields: [partnerId], references: [id])
  dealId          String
  deal            PartnerDeal           @relation(fields: [dealId], references: [id])
  status          PartnerContractStatus @default(REQUESTED)
  rejectionReason String?
  pdfUrl          String?
  requestedAt     DateTime              @default(now())
  reviewedAt      DateTime?
  reviewedBy      String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@index([partnerId])
  @@index([dealId])
  @@index([status])
  @@map("partner_contracts")
}

model PartnerInvoice {
  id              String               @id @default(cuid())
  partnerId       String
  partner         PartnerProfile       @relation(fields: [partnerId], references: [id])
  dealId          String
  deal            PartnerDeal          @relation(fields: [dealId], references: [id])
  status          PartnerInvoiceStatus @default(REQUESTED)
  amount          Float
  rejectionReason String?
  pdfUrl          String?
  requestedAt     DateTime             @default(now())
  reviewedAt      DateTime?
  reviewedBy      String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([partnerId])
  @@index([dealId])
  @@index([status])
  @@map("partner_invoices")
}

// ============================================================================
// PARTNERS MODULE — Commissions
// ============================================================================

model PartnerCommission {
  id         String                  @id @default(cuid())
  partnerId  String
  partner    PartnerProfile          @relation(fields: [partnerId], references: [id])
  dealId     String                  @unique
  deal       PartnerDeal             @relation(fields: [dealId], references: [id])
  amount     Float
  rate       Float
  status     PartnerCommissionStatus @default(PENDING)
  approvedAt DateTime?
  paidAt     DateTime?
  createdAt  DateTime                @default(now())
  updatedAt  DateTime                @updatedAt

  @@index([partnerId])
  @@index([dealId])
  @@index([status])
  @@index([partnerId, status])
  @@map("partner_commissions")
}

// ============================================================================
// PARTNERS MODULE — Notifications & Audit
// ============================================================================

model PartnerNotification {
  id        String                  @id @default(cuid())
  userId    String
  type      PartnerNotificationType @default(GENERAL)
  title     String
  message   String
  isRead    Boolean                 @default(false)
  metadata  Json?
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt

  @@index([userId])
  @@index([userId, isRead])
  @@map("partner_notifications")
}

model PartnerAuditLog {
  id            String   @id @default(cuid())
  userId        String
  action        String
  entity        String
  entityId      String
  oldData       Json?
  newData       Json?
  ipAddress     String?
  /// auth User.id of the admin when the action was performed under
  /// impersonation. userId is the target; this column reveals the
  /// admin behind the action. Null on regular self-acted rows.
  actingAdminId String?
  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("partner_audit_logs")
}
